# Vorlage fuer /etc/quick-check.env
# Kopieren, Werte eintragen, dann: chown root:root und chmod 600
# Diese Datei enthaelt absichtlich kein echtes Token.

PORT=3000
DATA_FILE=/var/lib/quick-check/data.json

# Pflicht. Ohne gesetztes Token antworten /api/data und /api/reset mit 503.
# Lang und zufaellig erzeugen, z. B.:  openssl rand -base64 36 | tr -d '/+='
ADMIN_TOKEN=BITTE-ERSETZEN

# Erlaubte Herkuenfte fuer Anfragen aus dem Browser, Kommaliste.
ALLOWED_ORIGINS=https://rlethmate.github.io,https://it-team-flow.de

# Basis-URL fuer den QR-Code. Muss zum Namen im Caddyfile passen.
PUBLIC_URL=https://atlas-quick-check.it-agile.de

# --- Benachrichtigung bei neuen Anfragen -------------------------------------
# Ohne SMTP_HOST, NOTIFY_TO und NOTIFY_FROM meldet der Dienst nichts. Anfragen
# werden dann trotzdem gespeichert, liegen aber bis zur Abholung ueber
# /api/data in DATA_FILE. Der Dienst warnt beim Start, wenn das der Fall ist.
#
# SMTP_PASS ist ein Geheimnis. Es gehoert ausschliesslich hierher, auf den
# Server, in eine Datei mit chmod 600 und chown root:root. Nicht in das
# Repository, nicht in den Dropbox-Ordner, nicht in eine Notiz.

SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=1 nur bei TLS ab der ersten Verbindung, meist Port 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Wohin die Meldung geht. Kommaliste, gern ein Postfach statt einer Person,
# damit eine Anfrage nicht im Urlaub liegen bleibt.
NOTIFY_TO=

# Absender. Muss zu SMTP_USER passen, sonst weist der Postausgangsserver die
# Mail ab oder der Empfaenger stuft sie als Spam ein.
NOTIFY_FROM=

# NOTIFY_DRY_RUN=1 schreibt die Mail nur in das Journal, ohne sie zu senden.
# Zum Einrichten nuetzlich:  journalctl -u quick-check -f
NOTIFY_DRY_RUN=
