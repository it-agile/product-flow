[Unit]
Description=ATLAS Quick Check backend
After=network.target

[Service]
UMask=0077
Type=simple
WorkingDirectory=/opt/quick-check
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
User=quickcheck
Group=quickcheck

# Token und Konfiguration liegen ausserhalb dieser Datei, weil Unit-Dateien
# fuer alle lesbar sind. /etc/quick-check.env gehoert root und ist 0600.
EnvironmentFile=/etc/quick-check.env

# Absicherung: der Dienst braucht nur sein Datenverzeichnis
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quick-check

[Install]
WantedBy=multi-user.target
